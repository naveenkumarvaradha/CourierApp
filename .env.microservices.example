# All values below are REQUIRED — docker-compose will refuse to start any
# service until you replace them with real, random values in your own .env
# (never commit .env — only this .example file is tracked).

# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=courierdb
DB_USERNAME=courier_user
DB_PASSWORD=replace-with-a-strong-random-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-strong-random-password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-256-bit-key

# ─── Internal service-to-service auth ────────────────────────────────────────
# Shared secret the gateway signs identity headers with; every downstream
# service verifies it. Generate with: openssl rand -base64 48
APP_INTERNAL_SECRET=replace-with-a-random-value

# ─── Eureka ───────────────────────────────────────────────────────────────────
EUREKA_USERNAME=admin
EUREKA_PASSWORD=replace-with-a-strong-random-password

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The origin(s) your frontend is actually served from, e.g. https://your-host
CORS_ORIGINS=http://localhost:5173

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Set to true to enable Kafka event publishing and consumption
KAFKA_ENABLED=true

# ─── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Set to the public IP/hostname of your API Gateway
VITE_API_BASE_URL=http://localhost:8080/api
