# ─── Database ─────────────────────────────────────────────────────────────────
DB_NAME=courierdb
DB_USERNAME=courier_user
DB_PASSWORD=courier_pass

# ─── JWT ──────────────────────────────────────────────────────────────────────
APP_JWT_SECRET=change-me-to-a-secure-256bit-key-in-production-must-be-very-long

# ─── Eureka ───────────────────────────────────────────────────────────────────
EUREKA_USERNAME=admin
EUREKA_PASSWORD=admin123

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Set to true to enable Kafka event publishing and consumption
KAFKA_ENABLED=true

# ─── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Set to the public IP/hostname of your API Gateway
VITE_API_BASE_URL=http://localhost:8080/api
