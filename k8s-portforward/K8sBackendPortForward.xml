<service>
  <id>K8sBackendPortForward</id>
  <name>CourierApp K8s Backend Port-Forward</name>
  <description>Persistent kubectl port-forward exposing the courierapp backend service on localhost:18080</description>
  <executable>C:\Program Files\Docker\Docker\resources\bin\kubectl.exe</executable>
  <arguments>port-forward -n courierapp svc/backend-published 18080:8080 --address=0.0.0.0</arguments>
  <env name="KUBECONFIG" value="C:\Users\naveenkumarv.TROPICKNITS\.kube\config"/>
  <startmode>Automatic</startmode>
  <logpath>D:\Application\CourierApp\k8s-portforward\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
