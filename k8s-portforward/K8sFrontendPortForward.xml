<service>
  <id>K8sFrontendPortForward</id>
  <name>CourierApp K8s Frontend Port-Forward</name>
  <description>Persistent kubectl port-forward exposing the courierapp frontend service on localhost:18090</description>
  <executable>C:\Program Files\Docker\Docker\resources\bin\kubectl.exe</executable>
  <arguments>port-forward -n courierapp svc/frontend-published 18090:8090 --address=0.0.0.0</arguments>
  <startmode>Automatic</startmode>
  <logpath>D:\Application\CourierApp\k8s-portforward\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
