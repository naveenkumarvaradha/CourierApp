# Copy this file to .env and fill in your values
# docker-compose automatically loads .env
# Never commit .env — only this .example file is tracked.

# ── Database password (required) ───────────────────────────────────────────
DB_PASSWORD=replace-with-a-strong-random-password

# ── Redis password (required) ──────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-strong-random-password

# ── JWT Secret (required — use a long random string, e.g. `openssl rand -base64 48`)
APP_JWT_SECRET=replace-with-a-random-256-bit-key

# ── Frontend API URL (set to your server's public IP or domain) ───────────
VITE_API_BASE_URL=http://192.168.2.245:8080/api

# ── Mail (optional — leave blank to disable email features) ───────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
