# Copy this file to .env and fill in your values
# docker-compose automatically loads .env
# Never commit .env — only this .example file is tracked.

# ── Database password (required) ───────────────────────────────────────────
DB_PASSWORD=replace-with-a-strong-random-password

# ── Redis password (required) ──────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-strong-random-password

# ── JWT Secret (required — use a long random string, e.g. `openssl rand -base64 48`)
APP_JWT_SECRET=replace-with-a-random-256-bit-key

# ── Frontend API URL ────────────────────────────────────────────────────────
# Leave as the relative default — nginx now reverse-proxies /api to the
# backend on the internal docker network (see frontend/nginx.conf.template),
# so the browser only ever talks to one same-origin host over HTTPS.
VITE_API_BASE_URL=/api

# ── TLS ─────────────────────────────────────────────────────────────────────
# Generate a cert before first run: ./scripts/generate-self-signed-cert.sh <your-host-or-ip>
# For real production, replace frontend/certs/server.{crt,key} with a CA-issued cert.

# ── Mail (optional — leave blank to disable email features) ───────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
