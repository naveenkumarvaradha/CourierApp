# Copy this file to .env and fill in your values
# docker-compose automatically loads .env

# ── JWT Secret (required — use a long random string) ──────────────────────
APP_JWT_SECRET=change-me-to-a-256bit-random-key

# ── Frontend API URL (set to your server's public IP or domain) ───────────
VITE_API_BASE_URL=http://192.168.2.245:8080/api

# ── Mail (optional — leave blank to disable email features) ───────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
