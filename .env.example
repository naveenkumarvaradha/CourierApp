# Copy this file to .env and fill in your values, then export before
# running the backend (e.g. `export $(grep -v '^#' .env | xargs)`),
# or set these as your shell/IDE run-configuration environment variables.

# ── Database ─────────────────────────────────────────────────────────────
DB_USERNAME=courier_app
DB_PASSWORD=Courier@123

# ── JWT Secret (required — HS512 needs >= 64 characters / 512 bits) ────────
JWT_SECRET=change-me-to-a-secure-random-string-that-is-at-least-64-characters-long

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS / Frontend ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# ── Kafka (disabled by default) ──────────────────────────────────────────
KAFKA_ENABLED=false

# ── Mail (optional — leave blank to disable email features) ────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
