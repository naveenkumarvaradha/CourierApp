# Copy this file to .env and fill in your values
# docker-compose automatically loads .env

# ── JWT Secret (required — HS512 needs >= 64 characters / 512 bits) ────────
JWT_SECRET=change-me-to-a-secure-random-string-that-is-at-least-64-characters-long

# ── Frontend API URL ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api

# ── Mail (optional — leave blank to disable email features) ───────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
